---
// Une page par offre. Le contenu vient de services.items dans les fichiers de langue.
// Les quatre domaines n'ont pas de « parent » ; une offre détaillée (ex. Odoo, Nextcloud et
// Mattermost) indique son domaine avec « parent » et s'affiche sous celui-ci. Une offre peut
// elle-même avoir une sous-offre (ex. Développement Odoo → Odoo en khmer, pour le Cambodge).
// Champs facultatifs d'une offre (ex. la page Linux) :
//   heading : titre affiché en haut de la page, s'il diffère du titre des listes (title) ;
//   card : { title, text } → titre et texte de sa carte sur la page de son domaine ;
//   actions : [{ label, emailSubject } | { label, anchor }] → boutons du haut de page
//             (e-mail avec objet pré-rempli, ou lien vers une ancre de la page) ;
//   contact : { title, emailSubject } → titre et objet d'e-mail du bloc de contact (ancre #contact) ;
//   entries : { icon, title, cards } → entrées par service : premier bloc de la page, reprises sur la
//             page Services et sur l'accueil (OfferEntries.astro) ;
//   terminal : 'usages' → fenêtre de terminal décorative dans le haut de page, une ligne par carte du
//             bloc portant cet id (titre de la carte + son champ stack) ;
//   mascot : 'tux' → Tux, la mascotte de Linux, posé au coin du terminal (src/assets/linux/, avec
//             ses conditions d'utilisation ; le crédit est dans la note sur les marques de l'offre).
import Page from '../../../layouts/Page.astro';
import PageHero from '../../../components/PageHero.astro';
import Sections from '../../../components/Sections.astro';
import HmsIcon from '../../../components/HmsIcon.astro';
import Terminal from '../../../components/Terminal.astro';
import tuxUrl from '../../../assets/linux/tux.svg?url';
import { languages, t, href } from '../../../i18n/index.js';
import config from '../../../../site.config.mjs';
import { serviceJsonLd } from '../../../lib/jsonld.js';
import { Picture } from 'astro:assets';
import showcase from '../../../data/showcase.js';
import galleries from '../../../data/service-galleries.js';
import ScreenGallery from '../../../components/ScreenGallery.astro';
import projects from '../../../data/projects.js';
import workImages from '../../../data/work-images.js';
import { screensFor } from '../../../data/hms-screens.js';

export function getStaticPaths() {
  return languages.flatMap((l) =>
    t(l.code).services.items.map((item) => ({ params: { lang: l.code, service: item.id } })),
  );
}

const { lang, service } = Astro.params;
const tr = t(lang);
const items = tr.services.items;
const item = items.find((i) => i.id === service);
const parent = item.parent ? items.find((i) => i.id === item.parent) : null;
const children = items.filter((i) => i.parent === item.id);
const page = `services/${service}`;
const actionHref = (a) =>
  a.emailSubject ? `mailto:${config.contact.email}?subject=${encodeURIComponent(a.emailSubject)}` : `#${a.anchor}`;
// Galerie de captures (src/data/service-galleries.js) : la première capture s'affiche aussi dans le haut
// de page, dans un cadre de navigateur ; la galerie se place après les `galleryAfter` premiers blocs.
const gallery = galleries[service] && item.gallery ? galleries[service] : null;
const heroShot = gallery?.find((s) => s.src.width > s.src.height);
// Fenêtre de terminal du haut de page : une ligne par carte du bloc désigné par item.terminal.
const terminal = (item.sections.find((s) => item.terminal && s.id === item.terminal)?.cards ?? [])
  .filter((c) => c.stack).map((c) => ({ label: c.title, items: c.stack }));
const mascots = { tux: { src: tuxUrl, width: 216, height: 256 } };
const mascot = mascots[item.mascot];
// Les entrées par service forment le premier bloc de la page.
const sections = item.entries
  ? [{ id: 'services', title: item.entries.title, cards: item.entries.cards }, ...item.sections]
  : item.sections;
const splitAt = gallery ? (item.galleryAfter ?? 0) + (item.entries ? 1 : 0) : 0;
// Réalisations à montrer sur cette offre (src/data/showcase.js), avec leur image.
const shown = (showcase[service] ?? []).map((id) => {
  const p = projects.find((x) => x.id === id);
  const image = id === 'hms' ? screensFor(lang).find((s) => s.caption === 'dashboard').src : workImages[id]?.[0];
  return { ...p, ...tr.work.items[id], image, target: p.page ? href(lang, p.page) : href(lang, 'work') };
});
---
<Page lang={lang} page={page}
      title={item.metaTitle ?? `${item.title} — Chantrea Systems`}
      description={item.metaDescription ?? item.summary}
      jsonLd={[serviceJsonLd(Astro.site, lang, item)]} contact={item.contact}>
  {heroShot || terminal.length ? (
    <section class="page-hero night hms-hero">
      <div class="container hms-hero__grid">
        <div>
          <p class="eyebrow">{parent ? parent.title : tr.nav.services}</p>
          <h1>{item.heading ?? item.title}</h1>
          <p class="lead">{item.lead}</p>
          {item.badges && <p class="hero-badges" aria-hidden="true">{item.badges.map((b) => <span lang={/[\u1780-\u17FF]/.test(b) ? 'km' : undefined}>{b}</span>)}</p>}
          {item.actions && <div class="actions">{item.actions.map((a, i) => <a class={i ? 'btn btn--ghost' : 'btn btn--primary'} href={actionHref(a)}>{a.label}</a>)}</div>}
        </div>
        {/* Première capture de la galerie, décorative (elle est aussi dans la galerie) ; sans capture,
            la fenêtre de terminal de l'offre. */}
        {heroShot ? (
          <div class="browser-frame" aria-hidden="true">
            <div class="browser-frame__bar"><span></span><span></span><span></span></div>
            <Picture src={heroShot.src} alt="" formats={['avif', 'webp']} widths={[480, 720, 960]}
              sizes="(min-width: 1120px) 560px, (min-width: 900px) 50vw, 100vw" quality={80} loading="eager" />
          </div>
        ) : (
          <div class="hero-visual" aria-hidden="true">
            <Terminal lines={terminal} />
            {mascot && <img class="hero-visual__mascot" src={mascot.src} width={mascot.width} height={mascot.height} alt="" decoding="async" />}
          </div>
        )}
      </div>
      <div class="hero__moon hero__moon--small" aria-hidden="true"></div>
    </section>
  ) : (
    <PageHero eyebrow={parent ? parent.title : tr.nav.services} title={item.heading ?? item.title} lead={item.lead}>
      {/* Badges décoratifs facultatifs (ex. ខ្មែរ · English · USD · KHR), item.badges dans le fichier de langue. */}
      {item.badges && <p class="hero-badges" aria-hidden="true">{item.badges.map((b) => <span lang={/[\u1780-\u17FF]/.test(b) ? 'km' : undefined}>{b}</span>)}</p>}
      {item.actions && <div class="actions">{item.actions.map((a, i) => <a class={i ? 'btn btn--ghost' : 'btn btn--primary'} href={actionHref(a)}>{a.label}</a>)}</div>}
    </PageHero>
  )}
  {splitAt > 0 && (
    <section class="section">
      <div class="container narrow">
        <Sections sections={sections.slice(0, splitAt)} lang={lang} />
      </div>
    </section>
  )}
  {gallery && <ScreenGallery screens={gallery} texts={item.gallery} alt />}
  <section class="section">
    <div class="container narrow">
      <Sections sections={sections.slice(splitAt)} lang={lang} />
      {children.map((c) => (
        <aside class={c.icon ? 'card offer-link offer-link--icon' : 'card offer-link'} aria-labelledby={`offer-${c.id}`}>
          {c.icon && <span class="hms-icon-box"><HmsIcon name={c.icon} /></span>}
          <p class="eyebrow">{tr.services.related}</p>
          <h2 class="h3" id={`offer-${c.id}`}>{c.card?.title ?? c.title}</h2>
          <p>{c.card?.text ?? c.summary}</p>
          <a class="card__link" href={href(lang, `services/${c.id}`)}>
            {tr.services.more}<span class="sr-only"> : {c.card?.title ?? c.title}</span> →
          </a>
        </aside>
      ))}
      {shown.length > 0 && (
        <ul class="showcase">
          {shown.map((p) => (
            <li>
              <a href={p.target}>
                {p.image && <Picture src={p.image} alt="" formats={['avif', 'webp']} widths={[240, 360]}
                  sizes="(min-width: 760px) 11rem, 45vw" quality={75} loading="lazy" />}
                <span>{p.title}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {item.examples && (
        <p class="note">{item.examples} <a href={href(lang, 'work')}>{tr.nav.work}</a></p>
      )}
      {item.trademarks && <p class="trademarks">{item.trademarks}</p>}
      <p class="back">
        {parent
          ? <a href={href(lang, `services/${parent.id}`)}>← {parent.title}</a>
          : <a href={href(lang, 'services')}>← {tr.services.back}</a>}
      </p>
    </div>
  </section>
</Page>
