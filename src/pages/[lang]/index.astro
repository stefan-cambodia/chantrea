---
// Accueil : présentation (captures HMS et Vigie), quatre domaines, HMS, infrastructure, Odoo et Mattermost, sécurité,
// sélection de réalisations (« En cours », « Nos réalisations », « Son et musique », comme la page Réalisations),
// fondateur et méthode, publics, contact.
import Page from '../../layouts/Page.astro';
import Txt from '../../components/Txt.astro';
import MoonPhase from '../../components/MoonPhase.astro';
import DomainIcon from '../../components/DomainIcon.astro';
import InfraDiagram from '../../components/InfraDiagram.astro';
import InventoryFlow from '../../components/InventoryFlow.astro';
import InvoiceMock from '../../components/InvoiceMock.astro';
import HmsIcon from '../../components/HmsIcon.astro';
import { Picture } from 'astro:assets';
import { homeScreen as rallyScreen } from '../../data/rally-screens.js';
import { homeScreen as angkorScreen } from '../../data/angkor-screens.js';
import { screensFor } from '../../data/hms-screens.js';
import projects from '../../data/projects.js';
import workImages from '../../data/work-images.js';
import vigieScreens from '../../data/vigie-screens.js';
import { langPaths, t, href } from '../../i18n/index.js';

export const getStaticPaths = langPaths;

const { lang } = Astro.params;
const tr = t(lang);
const h = tr.home;
const w = tr.work;
const phases = [0.25, 0.5, 0.75, 1];
const domains = tr.services.items.filter((i) => !i.parent);
const hmsScreens = screensFor(lang);
const hmsScreen = hmsScreens.find((s) => s.caption === 'dashboard');
// Bloc HMS : le calendrier, pour ne pas répéter le tableau de bord du bandeau.
const hmsCalendar = hmsScreens.find((s) => s.caption === 'calendar');
// Vigie (veille de sécurité) : textes de l'offre et lien de la page Cybersécurité ; captures de démonstration.
const vigie = tr.services.items.find((i) => i.id === 'vigie');
const vigieLink = tr.services.items.find((i) => i.id === 'security').sections.find((x) => x.link?.page === 'services/vigie').link;
const vigieShot = vigieScreens.find((s) => s.caption === 'expositions');
const vigiePhone = vigieScreens.find((s) => s.caption === 'mobile');
// Pictogrammes, dans l'ordre des cartes (identique dans les cinq langues).
const appIcons = ['receipt', 'chat', 'cloud'];
const audienceIcons = ['hotel', 'tag', 'globe', 'cloud'];
// Bandeau « Développement de modules Odoo » : textes de l'offre (services.items), rien de nouveau.
const odooDev = tr.services.items.find((i) => i.id === 'odoo-development');
const odooDomain = tr.services.items.find((i) => i.id === odooDev.parent);
const odooKh = tr.services.items.find((i) => i.id === 'odoo-cambodia');

// Sélection de réalisations, dans l'ordre de la page Réalisations :
// deux projets en cours, tous les projets de « Nos réalisations », puis « Son et musique », chacun avec son image
// (HMS : tableau de bord dans la langue de la page ; les autres : src/data/work-images.js).
const project = (id) => ({ ...projects.find((p) => p.id === id), ...w.items[id] });
const byGroup = (g) => projects.filter((p) => p.group === g).map((p) => project(p.id));
const workGroups = [
  {
    id: 'skills', tag: 'tag--rd', card: 'project--rd',
    items: [
      { ...project('rally'), image: rallyScreen.src },
      { ...project('angkor'), image: angkorScreen.src },
    ],
  },
  {
    id: 'products', tag: 'tag--product', card: 'project--product',
    items: byGroup('products').map((p) => ({ ...p, image: p.id === 'hms' ? hmsScreen.src : workImages[p.id]?.[0] })),
  },
  { id: 'sound', tag: 'tag--sound', card: 'project--sound', items: byGroup('sound').map((p) => ({ ...p, image: workImages[p.id]?.[0] })) },
];
---
<Page lang={lang} title={tr.meta.home.title} description={tr.meta.home.description}>
  <section class="hero night">
    <div class="container home-hero__grid">
      <div class="home-hero__text">
        <p class="eyebrow">{h.hero.eyebrow}</p>
        <h1>{h.hero.title}</h1>
        <p class="lead">{h.hero.lead}</p>
        <div class="actions">
          <a class="btn btn--primary" href={href(lang, 'contact')}>{h.hero.ctaPrimary}</a>
          <a class="btn btn--ghost" href={href(lang, 'services')}>{h.hero.ctaSecondary}</a>
        </div>
      </div>
      <div class="home-hero__devices" aria-hidden="true">
        <div class="browser-frame">
          <div class="browser-frame__bar"><span></span><span></span><span></span></div>
          <Picture src={hmsScreen.src} alt="" formats={['avif', 'webp']} widths={[560, 840, 1120]}
                   sizes="(min-width: 1120px) 560px, (min-width: 900px) 50vw, 100vw" quality={78} loading="eager" />
        </div>
        <div class="phone-frame">
          <Picture src={vigiePhone.src} alt="" formats={['avif', 'webp']} widths={[160, 240, 320]}
                   sizes="(min-width: 900px) 150px, 26vw" quality={78} loading="eager" />
        </div>
      </div>
    </div>
    <div class="hero__moon" aria-hidden="true"></div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title">{h.services.title}</h2>
      <p class="section__intro">{h.services.intro}</p>
      <ol class="cards cards--4 domains domains--color">
        {domains.map((s, i) => (
          <li class="card domain" data-domain={s.id}>
            <div class="domain__head">
              <DomainIcon id={s.id} />
              <span class="domain__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
            <ul class="checklist checklist--sm">{s.points.map((p) => <li>{p}</li>)}</ul>
            <a class="card__link" href={href(lang, `services/${s.id}`)}>
              {tr.services.more}<span class="sr-only"> : {s.title}</span> →
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="hms-title">
    <div class="container split split--media">
      <div>
        <p class="eyebrow">{h.hms.eyebrow}</p>
        <h2 id="hms-title">{h.hms.title}</h2>
        <p>{h.hms.text}</p>
        <p class="demo-badge"><span class="demo-badge__dot" aria-hidden="true"></span>{h.hms.demo}</p>
        <ul class="checklist">{h.hms.points.map((p) => <li>{p}</li>)}</ul>
        <div class="actions">
          <a class="btn btn--primary" href={href(lang, 'hms')}>{h.hms.cta}</a>
          <a class="btn btn--ghost" href={href(lang, 'contact')}>{tr.hms.cta}</a>
        </div>
      </div>
      <a class="media" href={href(lang, 'hms')} tabindex="-1" aria-hidden="true">
        <Picture
          src={hmsCalendar.src}
          alt=""
          formats={['avif', 'webp']}
          widths={[480, 720, 960]}
          sizes="(min-width: 1120px) 520px, (min-width: 860px) 45vw, 100vw"
          quality={80}
          loading="lazy"
        />
      </a>
    </div>
  </section>

  <section class="section night odoo-band" aria-labelledby="odoo-dev-title">
    <div class="container split split--center">
      <div>
        <p class="eyebrow">{odooDomain.title}</p>
        <h2 id="odoo-dev-title">{odooDev.title}</h2>
        <p class="lead-sm">{odooDev.summary}</p>
        <ul class="checklist">{odooDev.sections[0].list.slice(0, 4).map((p) => <li>{p}</li>)}</ul>
        <div class="actions">
          <a class="btn btn--primary" href={href(lang, 'services/odoo-development')}>{tr.services.more}<span class="sr-only"> : {odooDev.title}</span> →</a>
          <a class="btn btn--ghost" href={href(lang, 'services/odoo-cambodia')}>{odooKh.title}</a>
        </div>
      </div>
      <InvoiceMock />
    </div>
  </section>

  <section class="section" aria-labelledby="infra-title">
    <div class="container split split--center">
      <div>
        <p class="eyebrow">{h.infra.eyebrow}</p>
        <h2 id="infra-title">{h.infra.title}</h2>
        <p>{h.infra.text}</p>
        <ul class="checklist">{h.infra.points.map((p) => <li>{p}</li>)}</ul>
        <div class="actions">
          <a class="btn btn--primary" href={href(lang, 'services/infrastructure')}>{h.infra.cta}</a>
        </div>
      </div>
      <InfraDiagram d={tr.diagram} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="apps-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{h.apps.eyebrow}</p>
        <h2 id="apps-title">{h.apps.title}</h2>
        <p class="section__intro">{h.apps.text}</p>
      </div>
      <ul class="cards cards--3">
        {h.apps.cards.map((c, i) => (
          <li class="card app-card">
            <span class="app-card__icon"><HmsIcon name={appIcons[i]} size={26} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <ul class="checklist checklist--sm">{c.points.map((p) => <li>{p}</li>)}</ul>
            <p class="card__links">
              {c.links.map((l) => <a class="card__link" href={href(lang, l.page)}>{l.label} →</a>)}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="security-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{h.security.eyebrow}</p>
        <h2 id="security-title">{h.security.title}</h2>
        <p class="section__intro">{h.security.text}</p>
      </div>
      <InventoryFlow f={tr.inventoryFlow} />
      <div class="actions">
        <a class="btn btn--primary" href={href(lang, 'services/security')}>{h.security.cta}</a>
      </div>
      <div class="vigie-band">
        <div class="vigie-band__text">
          <p class="vigie-band__free">{vigie.badges[0]}</p>
          <h3>{vigie.title}</h3>
          <p>{vigie.summary}</p>
          <ol class="vigie-band__scale" aria-hidden="true">
            {[1, 2, 3, 4].map((n) => <li class={`vigie-band__p vigie-band__p--${n}`}>P{n}</li>)}
          </ol>
          <a class="btn btn--primary" href={href(lang, vigieLink.page)}>{vigieLink.label} →</a>
        </div>
        <a class="vigie-band__shot" href={href(lang, vigieLink.page)} tabindex="-1" aria-hidden="true">
          <Picture src={vigieShot.src} alt="" formats={['avif', 'webp']} widths={[480, 720, 960]}
                   sizes="(min-width: 1120px) 560px, (min-width: 900px) 50vw, 100vw" quality={78} loading="lazy" />
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="work-title">
    <div class="container">
      <h2 id="work-title">{h.work.title}</h2>
      <p class="section__intro">{h.work.text}</p>

      {workGroups.map((g) => (
        <>
          <h3 class="group-title"><span class={`tag ${g.tag}`}>{w[g.id].tag}</span> {w[g.id].title}</h3>
          <ul class={`cards ${g.id === 'products' ? 'cards--3 cards--work' : 'cards--2'}`}>
            {g.items.map((p) => {
              const target = p.page ? href(lang, p.page) : p.url;
              const external = !p.page && p.url;
              return (
                <li class={`card project ${g.card}`}>
                  {p.image && (
                    <a class="project__media" href={target} target={external ? '_blank' : undefined}
                       rel={external ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
                      <Picture
                        src={p.image}
                        alt=""
                        formats={['avif', 'webp']}
                        widths={[480, 720]}
                        sizes={g.id === 'products' ? '(min-width: 1120px) 360px, (min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw' : '(min-width: 1120px) 536px, (min-width: 640px) 50vw, 100vw'}
                        quality={75}
                        loading="lazy"
                      />
                    </a>
                  )}
                  <p class="eyebrow">{p.kind}</p>
                  <h4 class="h3">{p.title}</h4>
                  <p class="status"><span class="sr-only">{w.status} : </span>{p.status}</p>
                  <p>{p.text}</p>
                  {p.link && target && (
                    <a class="card__link" href={target} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                      {p.link} {external ? '↗' : '→'}{external && <span class="sr-only"> {tr.a11y.newWindow}</span>}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      ))}
      <p class="more-link"><a class="btn btn--ghost" href={href(lang, 'work')}>{h.work.cta}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="single-title">
    <div class="container split">
      <div>
        <h2 id="single-title">{h.single.title}</h2>
        <p class="lead-sm">{h.single.text}</p>
        <a class="card__link" href={href(lang, 'about')}>{tr.nav.about} →</a>
      </div>
      <ul class="checklist single-panel">
        {h.single.points.map((p) => <li><Txt text={p} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title">{h.steps.title}</h2>
      <ol class="steps steps--line">
        {h.steps.items.map((s, i) => (
          <li class="step">
            <MoonPhase lit={phases[i]} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="audiences-title">
    <div class="container">
      <h2 id="audiences-title">{h.audiences.title}</h2>
      <ul class="cards cards--4">
        {h.audiences.items.map((a, i) => (
          <li class="card card--plain audience">
            <span class="audience__icon"><HmsIcon name={audienceIcons[i]} size={26} /></span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>
