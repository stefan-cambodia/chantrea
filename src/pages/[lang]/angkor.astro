---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import screens from '../../data/angkor-screens.js';
import { langPaths, t, href } from '../../i18n/index.js';

export const getStaticPaths = langPaths;

const { lang } = Astro.params;
const tr = t(lang);
const a = tr.angkor;
---
<Page lang={lang} page="angkor" title={tr.meta.angkor.title} description={tr.meta.angkor.description}>
  <PageHero eyebrow={a.eyebrow} title={a.title} lead={a.lead}>
    <p class="status"><span class="sr-only">{tr.work.status} : </span>{a.status}</p>
  </PageHero>

  <ScreenGallery screens={screens} texts={a.gallery} />

  <section class="section section--alt" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title">{a.featuresTitle}</h2>
      <ul class="cards cards--3 features">
        {a.groups.map((g) => (
          <li class="card">
            <h3>{g.title}</h3>
            <ul class="checklist checklist--sm">{g.items.map((i) => <li>{i}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="shows-title">
    <div class="container split">
      <div>
        <h2 id="shows-title">{a.shows.title}</h2>
        <p>{a.shows.text}</p>
        <a class="btn btn--ghost" href={href(lang, 'work')}>{a.shows.cta}</a>
      </div>
      <ul class="checklist">{a.shows.items.map((i) => <li>{i}</li>)}</ul>
    </div>
    <p class="container credits">{a.credits}</p>
  </section>
</Page>
