---
// Fiche d'une réalisation Android (Acpc, ASokoban, 3D Snake, Velocity) : une page par fiche et par langue.
// Liste des fiches et captures : src/data/app-pages.js ; textes : apps.<id> et meta.<id>.
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import ScreenGallery from '../../components/ScreenGallery.astro';
import apps from '../../data/app-pages.js';
import { languages, t, href } from '../../i18n/index.js';

export function getStaticPaths() {
  return languages.flatMap((l) =>
    apps.map((app) => ({ params: { lang: l.code, app: app.slug }, props: { app } })),
  );
}

const { lang } = Astro.params;
const { app } = Astro.props;
const tr = t(lang);
const a = tr.apps[app.id];
const meta = tr.meta[app.id];
---
<Page lang={lang} page={app.slug} title={meta.title} description={meta.description}>
  <PageHero eyebrow={a.eyebrow} title={a.title} lead={a.lead}>
    <p class="status"><span class="sr-only">{tr.work.status} : </span>{a.status}</p>
  </PageHero>

  <ScreenGallery screens={app.screens} texts={a.gallery} />

  <section class="section section--alt" aria-labelledby="features-title">
    <div class="container">
      <h2 id="features-title">{a.featuresTitle}</h2>
      <ul class="cards cards--3 features">
        {a.groups.map((g) => (
          <li class="card">
            <h3>{g.title}</h3>
            <ul class="checklist checklist--sm">{g.items.map((i) => <li>{i}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="shows-title">
    <div class="container split">
      <div>
        <h2 id="shows-title">{a.shows.title}</h2>
        <p>{a.shows.text}</p>
        <a class="btn btn--ghost" href={href(lang, 'work')}>{a.shows.cta}</a>
      </div>
      <ul class="checklist">{a.shows.items.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>
</Page>
