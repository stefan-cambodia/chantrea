---
// Derniers commits : les derniers changements des projets publics, regroupés par jour.
// La liste est écrite deux fois :
// 1. pendant la construction du site (src/lib/changes.js) : du HTML simple, lisible sans
//    JavaScript ;
// 2. dans le navigateur, par le script en bas de page : il relit GitHub et remplace la liste
//    quand un dépôt a reçu un envoi depuis la construction. Si GitHub ne répond pas, la liste
//    écrite à la construction reste affichée.
import config from '../../../site.config.mjs';
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import { MAX_CHANGES, latestChanges } from '../../lib/changes.js';
import { langPaths, language, t } from '../../i18n/index.js';

export const getStaticPaths = langPaths;

const { lang } = Astro.params;
const tr = t(lang);
const n = tr.whatsNew;
const { items, failed, at } = await latestChanges();

// Dates et heures écrites dans la langue de la page, à l'heure du Cambodge.
const timeZone = 'Asia/Phnom_Penh';
const offset = 7 * 60; // en minutes : le Cambodge est à UTC+7 toute l'année, sans heure d'été
const locale = { fr: 'fr-FR', en: 'en-GB', km: 'km-KH', ru: 'ru-RU', zh: 'zh-CN' }[lang] ?? language(lang).hreflang;
const dayKey = new Intl.DateTimeFormat('en-CA', { timeZone, year: 'numeric', month: '2-digit', day: '2-digit' });
const dayLabel = new Intl.DateTimeFormat(locale, { timeZone, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const clock = new Intl.DateTimeFormat(locale, { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const stamp = new Intl.DateTimeFormat(locale, { timeZone, day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });

// Un groupe par jour, du plus récent au plus ancien (la liste arrive déjà triée).
const days = [];
for (const c of items) {
  const when = new Date(c.date);
  const key = dayKey.format(when);
  if (days.at(-1)?.key !== key) days.push({ key, label: dayLabel.format(when), items: [] });
  days.at(-1).items.push({ ...c, time: clock.format(when), short: c.sha.slice(0, 7) });
}

const profile = `https://github.com/${config.github}`;
const count = n.count
  .replace('{changes}', String(items.length))
  .replace('{projects}', String(new Set(items.map((c) => c.repo)).size));
const [sourceBefore, sourceAfter = ''] = n.source.split('{date}');

// Le script en bas de page doit écrire les mêmes dates que ci-dessus. Il ne peut pas compter sur
// le navigateur : Chrome ne connaît pas le khmer et écrirait les jours dans une autre langue.
// On lui donne donc le modèle de chaque format, avec les noms des jours et des mois déjà écrits :
// { pattern: ['texte', ['d', 1], …], months: [12 noms], weekdays: [7 noms, dimanche d'abord] }.
function model(format) {
  const fields = { weekday: 'w', day: 'd', month: 'm', year: 'y', hour: 'H', minute: 'M' };
  const value = (date, type) => format.formatToParts(date).find((p) => p.type === type)?.value;
  // Date d'essai à un seul chiffre partout (lundi 5 janvier 2026, 03:04 au Cambodge) :
  // la longueur de chaque nombre dit s'il faut un zéro devant.
  const parts = format.formatToParts(new Date(Date.UTC(2026, 0, 5, 3, 4) - offset * 60000));
  const has = (type) => parts.some((p) => p.type === type);
  return {
    pattern: parts.map((p) => (fields[p.type] ? [fields[p.type], p.value.length] : p.value)),
    months: has('month') ? Array.from({ length: 12 }, (_, i) => value(new Date(Date.UTC(2026, i, 15, 5)), 'month')) : undefined,
    weekdays: has('weekday') ? Array.from({ length: 7 }, (_, i) => value(new Date(Date.UTC(2026, 0, 4 + i, 5)), 'weekday')) : undefined,
  };
}
const formats = JSON.stringify({ offset, day: model(dayLabel), time: model(clock), stamp: model(stamp) });
---
<Page lang={lang} page="whats-new" title={tr.meta.whatsNew.title} description={tr.meta.whatsNew.description}>
  <PageHero eyebrow={n.eyebrow} title={n.title} lead={n.lead} />

  <section class="section">
    {/* Les attributs data-* donnent au script ce qu'il lui faut pour refaire la liste. */}
    <div
      class="container changes"
      id="changes"
      data-user={config.github}
      data-max={MAX_CHANGES}
      data-formats={formats}
      data-built={at.toISOString()}
      data-failed={failed ? '' : undefined}
      data-count={n.count}
      data-new-window={tr.a11y.newWindow}
    >
      {failed && <p class="note changes__error" data-changes="error">{n.error}</p>}
      <p class="section__intro" data-changes="intro" hidden={failed}>{sourceBefore}<time data-changes="stamp" datetime={at.toISOString()}>{stamp.format(at)}</time>{sourceAfter} {n.asWritten}</p>
      <div data-changes="days">
        {days.map((day) => (
          <section class="changes-day" aria-labelledby={`day-${day.key}`}>
            <h2 id={`day-${day.key}`} class="changes-day__title">{day.label}</h2>
            <ul class="card changes-list">
              {day.items.map((c) => (
                <li class="change">
                  <time class="change__time" datetime={c.date}>{c.time}</time>
                  <a class="change__repo" href={c.repoUrl} target="_blank" rel="noopener">
                    {c.repo}<span class="sr-only"> {tr.a11y.newWindow}</span>
                  </a>
                  {/* Les messages sont en français ou en anglais selon le projet : pas d'attribut lang fiable. */}
                  <a class="change__message" href={c.url} title={c.message} target="_blank" rel="noopener">
                    {c.message || c.short}<span class="sr-only"> {tr.a11y.newWindow}</span>
                  </a>
                  <span class="change__sha" aria-hidden="true">{c.short}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="changes__foot">
        <span data-changes="count" hidden={failed}>{count}</span>
        <a href={profile} target="_blank" rel="noopener">
          {n.all} ↗<span class="sr-only"> {tr.a11y.newWindow}</span>
        </a>
      </p>
    </div>
  </section>

  <script is:inline>
    // Rafraîchit la liste dans le navigateur, entre deux publications du site.
    // Même règle que src/lib/changes.js (dépôts publics, hors copies, du plus récent au plus
    // ancien) : garder les deux d'accord. Aucun cookie : le résultat est gardé dix minutes dans
    // la mémoire de l'onglet (sessionStorage), pour ne pas relire GitHub à chaque page.
    // À la moindre erreur (GitHub muet, limite de lectures atteinte), la liste écrite à la
    // construction reste telle quelle.
    (async function () {
      var root = document.getElementById('changes');
      if (!root || !window.fetch) return;
      var d = root.dataset;
      var formats = JSON.parse(d.formats);
      var MAX = Number(d.max), MAX_REPOS = 12, TTL = 6e5, KEY = 'changes-v1';
      var built = Date.parse(d.built);
      var part = function (name) { return root.querySelector('[data-changes="' + name + '"]'); };

      async function get(path) {
        var res = await fetch('https://api.github.com' + path, { headers: { Accept: 'application/vnd.github+json' } });
        if (res.status === 409) return []; // dépôt encore vide
        if (!res.ok) throw new Error(res.status);
        return res.json();
      }

      async function commitsOf(repo) {
        return (await get('/repos/' + repo.full_name + '/commits?per_page=' + MAX)).map(function (c) {
          return {
            repo: repo.name,
            repoUrl: repo.html_url,
            sha: c.sha,
            url: c.html_url,
            message: (c.commit.message || '').split('\n')[0].trim(),
            date: (c.commit.committer && c.commit.committer.date) || (c.commit.author && c.commit.author.date),
          };
        });
      }

      // Dépôts parcourus trois par trois ; on s'arrête dès qu'un dépôt ne peut plus rien
      // contenir de plus récent que le dernier changement gardé.
      async function load(repos) {
        var list = [];
        for (var i = 0; i < repos.length; i += 3) {
          var found = await Promise.all(repos.slice(i, i + 3).map(commitsOf));
          list = list.concat.apply(list, found)
            .filter(function (c) { return c.date; })
            .sort(function (a, b) { return Date.parse(b.date) - Date.parse(a.date); })
            .slice(0, MAX);
          var next = repos[i + 3];
          if (!next || (list.length >= MAX && Date.parse(list[list.length - 1].date) >= Date.parse(next.pushed_at))) break;
        }
        return list;
      }

      function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
      }

      // Lien qui s'ouvre dans une nouvelle fenêtre, seulement vers github.com.
      function link(className, href, text) {
        var a = el('a', className, text);
        a.href = /^https:\/\/github\.com\//.test(href) ? href : 'https://github.com/' + d.user;
        a.target = '_blank';
        a.rel = 'noopener';
        a.append(el('span', 'sr-only', ' ' + d.newWindow));
        return a;
      }

      // Écrit une date à l'heure du Cambodge, d'après un modèle préparé à la construction
      // (voir « model » en haut de ce fichier). Sans modèle : la clé du jour, AAAA-MM-JJ.
      function write(when, format) {
        var t = new Date(new Date(when).getTime() + formats.offset * 60000);
        if (!format) return t.toISOString().slice(0, 10);
        var value = {
          w: format.weekdays && format.weekdays[t.getUTCDay()],
          d: t.getUTCDate(),
          m: format.months && format.months[t.getUTCMonth()],
          y: t.getUTCFullYear(),
          H: t.getUTCHours(),
          M: t.getUTCMinutes(),
        };
        return format.pattern.map(function (p) {
          if (typeof p === 'string') return p;
          var v = value[p[0]];
          // Les nombres reçoivent leurs zéros ; les noms de jour et de mois sont déjà écrits.
          return typeof v === 'number' ? String(v).padStart(p[1], '0') : v;
        }).join('');
      }

      function show(list) {
        var days = document.createDocumentFragment();
        var last, ul;
        list.forEach(function (c) {
          var key = write(c.date);
          if (key !== last) {
            last = key;
            var day = el('section', 'changes-day');
            day.setAttribute('aria-labelledby', 'day-' + key);
            var title = el('h2', 'changes-day__title', write(c.date, formats.day));
            title.id = 'day-' + key;
            ul = el('ul', 'card changes-list');
            day.append(title, ul);
            days.append(day);
          }
          var short = c.sha.slice(0, 7);
          var time = el('time', 'change__time', write(c.date, formats.time));
          time.dateTime = c.date;
          var message = link('change__message', c.url, c.message || short);
          message.title = c.message;
          var sha = el('span', 'change__sha', short);
          sha.setAttribute('aria-hidden', 'true');
          var li = el('li', 'change');
          li.append(time, link('change__repo', c.repoUrl, c.repo), message, sha);
          ul.append(li);
        });
        part('days').replaceChildren(days);

        var projects = new Set(list.map(function (c) { return c.repo; })).size;
        var count = part('count');
        count.textContent = d.count.replace('{changes}', list.length).replace('{projects}', projects);
        count.hidden = false;
        part('intro').hidden = false;
        var error = part('error');
        if (error) error.remove();
      }

      // « Dernière mise à jour » : l'heure de la dernière lecture de GitHub.
      function mark(at) {
        var stamp = part('stamp');
        stamp.dateTime = new Date(at).toISOString();
        stamp.textContent = write(at, formats.stamp);
      }

      try {
        // Lecture gardée en mémoire : valable dix minutes, et seulement si elle est plus récente
        // que la construction du site. « list: null » = la liste écrite à la construction était
        // encore la bonne.
        var kept = null;
        try {
          kept = JSON.parse(sessionStorage.getItem(KEY) || 'null');
          if (!kept || !(Date.now() - kept.t < TTL) || !(kept.t > built)) kept = null;
        } catch (e) { kept = null; }

        if (!kept) {
          var repos = (await get('/users/' + d.user + '/repos?per_page=100&sort=pushed'))
            .filter(function (r) { return !r.private && !r.fork && r.pushed_at; })
            .sort(function (a, b) { return Date.parse(b.pushed_at) - Date.parse(a.pushed_at); })
            .slice(0, MAX_REPOS);
          // Aucun envoi depuis la construction : la liste de la page est déjà la bonne,
          // inutile de relire les changements.
          var upToDate = !('failed' in d) && (!repos.length || Date.parse(repos[0].pushed_at) <= built);
          kept = { t: Date.now(), list: upToDate ? null : await load(repos) };
          try { sessionStorage.setItem(KEY, JSON.stringify(kept)); } catch (e) {}
        }

        if (kept.list) show(kept.list);
        mark(kept.t);
      } catch (e) {}
    })();
  </script>
</Page>
