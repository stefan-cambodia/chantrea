---
import Txt from './Txt.astro';
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero night">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead"><Txt text={lead} /></p>}
    <slot />
  </div>
  <div class="hero__moon hero__moon--small" aria-hidden="true"></div>
</section>
