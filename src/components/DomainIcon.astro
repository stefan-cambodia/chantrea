---
// Pictogramme d'un domaine d'activité (id de services.items). Trait seul, couleur du texte.
interface Props { id: string; size?: number }
const { id, size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="domain-icon"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {id === 'development' && <>
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <path d="M3 8h18M9.5 12l-2.5 2.5 2.5 2.5M14.5 12l2.5 2.5-2.5 2.5" />
  </>}
  {id === 'ai' && <>
    <path d="M12 3.5l1.6 4.4 4.4 1.6-4.4 1.6L12 15.5l-1.6-4.4L6 9.5l4.4-1.6z" />
    <path d="M18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8zM5.5 15.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6z" />
  </>}
  {id === 'infrastructure' && <>
    <rect x="3.5" y="3.5" width="17" height="5" rx="1.2" />
    <rect x="3.5" y="9.5" width="17" height="5" rx="1.2" />
    <rect x="3.5" y="15.5" width="17" height="5" rx="1.2" />
    <path d="M7 6h.01M7 12h.01M7 18h.01M11 6h6M11 12h6M11 18h6" />
  </>}
  {id === 'security' && <>
    <path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z" />
    <path d="M8.8 12.2l2.2 2.2 4.2-4.4" />
  </>}
</svg>
