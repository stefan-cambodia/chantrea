---
// Sélecteur de langue : bouton avec la langue en cours, liste des autres.
// Fonctionne sans JavaScript (élément <details>).
import { languages, language, href } from '../i18n/index.js';
interface Props { lang: string; page?: string; label: string }
const { lang, page = '', label } = Astro.props;
const current = language(lang);
---
<details class="lang-switcher">
  <summary>
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></g></svg>
    <span class="sr-only">{label} : </span><span class="lang-long" lang={current.hreflang}>{current.label}</span><span class="lang-short" aria-hidden="true">{current.short}</span>
  </summary>
  <nav aria-label={label}>
    <ul>
      {languages.map((l) => (
        <li>
          <a href={href(l.code, page)} hreflang={l.hreflang} lang={l.hreflang}
             aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</details>
