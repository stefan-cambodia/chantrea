---
// Blocs de contenu génériques. Ajouter un bloc dans le fichier de langue suffit à l'afficher.
//   { title, text?, list?, defs?, link? }
//     defs : [{ term, text }]   → liste de définitions (ex. Xen, XCP-ng, Xen Orchestra)
//     link : { page, label }    → lien vers une page du site (ex. { "page": "hms", … })
//     flow : [étape, …]          → petit circuit en étapes fléchées (ex. Devis → Commande → Facture)
//     tiles : true               → la liste s'affiche en tuiles sur deux colonnes
//     cards : [{ icon, title, text?, list? }] → cartes avec pictogramme (noms de HmsIcon)
//     callout : true             → bloc mis en avant (encadré de couleur)
//     icon : nom de HmsIcon      → le bloc s'affiche en carte, avec ce pictogramme devant le titre
//     pending : true             → bloc « en cours de développement » (bordure en tirets, sablier)
//     steps : true               → la liste s'affiche en étapes numérotées
//     numbered : true            → les cartes (cards) sont numérotées 1, 2, 3…
//     scale : true               → échelle de priorité P1 → P4 (décorative) sous le texte
//   { figure: 'infra' | 'inventory' | 'invoice' } → schéma d'infrastructure, étapes inventaire et veille,
//                                    ou illustration d'une facture bilingue khmer / anglais
import Txt from './Txt.astro';
import InfraDiagram from './InfraDiagram.astro';
import InventoryFlow from './InventoryFlow.astro';
import HmsIcon from './HmsIcon.astro';
import InvoiceMock from './InvoiceMock.astro';
import { t, href } from '../i18n/index.js';
interface Section {
  title?: string; text?: string; list?: string[];
  defs?: { term: string; text: string }[];
  link?: { page: string; label: string };
  figure?: 'infra' | 'inventory' | 'invoice';
  flow?: string[]; tiles?: boolean; callout?: boolean; icon?: string; pending?: boolean; steps?: boolean; numbered?: boolean; scale?: boolean;
  cards?: { icon?: string; title: string; text?: string; list?: string[] }[];
}
interface Props { sections: Section[]; lang: string }
const { sections, lang } = Astro.props;
const tr = t(lang);
---
<div class="prose-sections">
  {sections.map((s) => (
    s.figure ? (
      s.figure === 'invoice' ? <InvoiceMock /> : (
        <section class="prose-section prose-section--figure">
          {s.figure === 'infra' && <InfraDiagram d={tr.diagram} heading="h2" />}
          {s.figure === 'inventory' && <InventoryFlow f={tr.inventoryFlow} heading="h2" />}
        </section>
      )
    ) : (
      <section class={['prose-section', s.callout && 'prose-section--callout', s.icon && 'prose-section--card',
                       s.pending && 'prose-section--pending'].filter(Boolean).join(' ')}>
        {s.icon || s.pending
          ? <div class="prose-section__head"><span class="hms-icon-box"><HmsIcon name={s.icon ?? 'hourglass'} /></span><h2>{s.title}</h2></div>
          : <h2>{s.title}</h2>}
        {s.text && <p><Txt text={s.text} /></p>}
        {s.scale && (
          <div class="priority-scale" aria-hidden="true">
            {['P1', 'P2', 'P3', 'P4'].map((p, i) => (
              <span class={`priority-scale__step priority-scale__step--${i + 1}`}><b>{p}</b><i></i></span>
            ))}
          </div>
        )}
        {s.flow && (
          <ol class="flow-chips">{s.flow.map((f) => <li>{f}</li>)}</ol>
        )}
        {s.defs && (
          <dl class="defs">
            {s.defs.map((d) => <div><dt>{d.term}</dt><dd>{d.text}</dd></div>)}
          </dl>
        )}
        {s.list && s.steps && <ol class="hms-steps">{s.list.map((li) => <li><Txt text={li} /></li>)}</ol>}
        {s.list && !s.steps && <ul class={s.tiles ? 'checklist tiles' : 'checklist'}>{s.list.map((li) => <li><Txt text={li} /></li>)}</ul>}
        {s.cards && (
          <ul class={s.numbered ? 'section-cards section-cards--numbered' : 'section-cards'}>
            {s.cards.map((c, i) => (
              <li class="card section-card">
                <div class="section-card__head">
                  {s.numbered && <span class="section-card__num" aria-hidden="true">{i + 1}</span>}
                  {c.icon && <span class="hms-icon-box"><HmsIcon name={c.icon} /></span>}
                  <h3>{c.title}</h3>
                </div>
                {c.text && <p><Txt text={c.text} /></p>}
                {c.list && <ul class="checklist checklist--sm">{c.list.map((li) => <li><Txt text={li} /></li>)}</ul>}
              </li>
            ))}
          </ul>
        )}
        {s.link && <p><a class="card__link" href={href(lang, s.link.page)}>{s.link.label} →</a></p>}
      </section>
    )
  ))}
</div>
