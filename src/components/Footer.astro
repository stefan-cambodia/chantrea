---
import config from '../../site.config.mjs';
import Brand from './Brand.astro';
import { t, href } from '../i18n/index.js';
interface Props { lang: string }
const { lang } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
const { legalName, registration } = config.legal;
---
<footer class="site-footer night">
  <div class="container site-footer__grid">
    <div>
      <Brand home={href(lang)} label={tr.a11y.home} id="logo-f" />
      <p class="muted">{tr.footer.tagline}</p>
    </div>
    <nav aria-label={tr.a11y.mainNav}>
      <ul class="footer-links">
        <li><a href={href(lang, 'services')}>{tr.nav.services}</a></li>
        <li><a href={href(lang, 'hms')}>{tr.nav.hms}</a></li>
        <li><a href={href(lang, 'rally')}>{tr.nav.rally}</a></li>
        <li><a href={href(lang, 'angkor')}>{tr.nav.angkor}</a></li>
        <li><a href={href(lang, 'work')}>{tr.nav.work}</a></li>
        <li><a href={href(lang, 'about')}>{tr.nav.about}</a></li>
        <li><a href={href(lang, 'contact')}>{tr.nav.contact}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer__legal">
    <p>{tr.footer.copyright.replace('{year}', String(year))}</p>
    {/* Emplacement des mentions légales : à remplir dans site.config.mjs après l'immatriculation. */}
    {(legalName || registration) && (
      <p class="legal">{[legalName, registration].filter(Boolean).join(' · ')}</p>
    )}
    <p>{tr.footer.privacy}</p>
  </div>
</footer>
