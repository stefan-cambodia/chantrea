---
// Pictogrammes des blocs de la page À propos. Trait seul, couleur du texte (currentColor).
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="about-icon"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'chat' && <>
    <path d="M4 5.5h11a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5H9l-3.5 3v-3H4A1.5 1.5 0 0 1 2.5 13V7A1.5 1.5 0 0 1 4 5.5z" />
    <path d="M16.5 9.5H20a1.5 1.5 0 0 1 1.5 1.5v5a1.5 1.5 0 0 1-1.5 1.5h-1v2.5l-3-2.5h-3.5" />
  </>}
  {name === 'role' && <>
    <circle cx="12" cy="12" r="9" />
    <path d="M15.5 8.5l-2 5-5 2 2-5z" />
  </>}
  {name === 'globe' && <>
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" />
  </>}
  {name === 'spark' && <>
    <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" />
  </>}
  {name === 'path' && <>
    <circle cx="6" cy="18" r="2" /><circle cx="18" cy="6" r="2" />
    <path d="M8 18h6.5a3.5 3.5 0 0 0 0-7h-5a3.5 3.5 0 0 1 0-7H16" />
  </>}
  {name === 'lang' && <>
    <path d="M3 5h9M7.5 3v2M5 5c.6 3 2.6 5.5 5.5 7M10 5c-.6 3-2.6 5.5-5.5 7" />
    <path d="M12.5 21l4-10 4 10M14 17.5h5" />
  </>}
  {name === 'jobs' && <>
    <rect x="3" y="7" width="18" height="13" rx="2" />
    <path d="M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3 12.5h18" />
  </>}
  {name === 'dot' && <circle cx="12" cy="12" r="4" />}
</svg>
