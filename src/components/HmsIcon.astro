---
// Pictogrammes de la page HMS (fonctions et blocs « Comment ça marche », « Langues », « Pour qui »).
// Trait seul, couleur du texte (currentColor).
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="hms-icon"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'calendar' && <>
    <rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4M7.5 13h3v3h-3z" />
  </>}
  {name === 'bell' && <>
    <path d="M4 17h16M5.5 17a6.5 6.5 0 0 1 13 0M12 10.5V8.5M10.5 8.5h3M3 20h18" />
  </>}
  {name === 'users' && <>
    <circle cx="9" cy="8.5" r="3.2" /><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0" />
    <path d="M15.5 5.6a3.2 3.2 0 0 1 0 6M17 14.2a5.5 5.5 0 0 1 3.5 5.3" />
  </>}
  {name === 'tag' && <>
    <path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1.4 1.4 0 0 1 0 2l-6.2 6.2a1.4 1.4 0 0 1-2 0z" /><circle cx="8" cy="8" r="1.4" />
  </>}
  {name === 'receipt' && <>
    <path d="M5.5 3.5h13v17l-2.2-1.5-2.1 1.5-2.2-1.5-2.2 1.5-2.1-1.5-2.2 1.5z" /><path d="M8.5 8h7M8.5 11.5h7M8.5 15h4" />
  </>}
  {name === 'moon' && <>
    <path d="M19.5 14.5A8 8 0 1 1 9.5 4.5a6.5 6.5 0 0 0 10 10z" />
  </>}
  {name === 'wrench' && <>
    <path d="M14.5 4.2a4.5 4.5 0 0 0-5.6 5.9L3.8 15.2a1.8 1.8 0 0 0 2.5 2.5l5.1-5.1a4.5 4.5 0 0 0 5.9-5.6l-2.6 2.6-2.3-.5-.5-2.3z" />
  </>}
  {name === 'utensils' && <>
    <path d="M6 3v7a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V3M8 3v18M16.5 21V3c-2 1.2-3 3.5-3 6.5v3h3" />
  </>}
  {name === 'car' && <>
    <path d="M4 16.5v-4l2-5a1.5 1.5 0 0 1 1.4-1h9.2a1.5 1.5 0 0 1 1.4 1l2 5v4M3.5 12.5h17M4 16.5h16" />
    <circle cx="7.5" cy="16.5" r="1.8" /><circle cx="16.5" cy="16.5" r="1.8" />
  </>}
  {name === 'chart' && <>
    <path d="M3.5 20.5h17M6.5 17v-5M11 17V7M15.5 17v-7M20 17V4.5" />
  </>}
  {name === 'badge' && <>
    <rect x="4.5" y="4" width="15" height="17" rx="2" /><circle cx="12" cy="10.5" r="2.5" /><path d="M8 17a4 4 0 0 1 8 0M10 4V2.5h4V4" />
  </>}
  {name === 'sun' && <>
    <circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
  </>}
  {name === 'server' && <>
    <rect x="3.5" y="4" width="17" height="7" rx="1.5" /><rect x="3.5" y="13" width="17" height="7" rx="1.5" /><path d="M7 7.5h.01M7 16.5h.01M11 7.5h6M11 16.5h6" />
  </>}
  {name === 'lang' && <>
    <path d="M3 5h9M7.5 3v2M5 5c.6 3 2.6 5.5 5.5 7M10 5c-.6 3-2.6 5.5-5.5 7" /><path d="M12.5 21l4-10 4 10M14 17.5h5" />
  </>}
  {name === 'hotel' && <>
    <path d="M4 20.5V5.5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v15M15 10h4a1 1 0 0 1 1 1v9.5M2.5 20.5h19M7.5 8h1.5M10.5 8H12M7.5 11.5h1.5M10.5 11.5H12M7.5 15h1.5M10.5 15H12" />
  </>}
  {name === 'coins' && <>
    <ellipse cx="9" cy="7" rx="5.5" ry="2.5" /><path d="M3.5 7v4c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5V7" />
    <path d="M9.5 15.4c.8 1.2 3 2.1 5.5 2.1 3 0 5.5-1.1 5.5-2.5v-4c0-1.2-1.8-2.2-4.3-2.5M20.5 15v4c0 1.4-2.5 2.5-5.5 2.5S9.5 20.4 9.5 19v-3" />
  </>}
  {name === 'scale' && <>
    <path d="M12 3.5v17M7 20.5h10M4.5 7h15M12 5.5" /><path d="M4.5 7L2 13a3 3 0 0 0 5 0zM19.5 7L17 13a3 3 0 0 0 5 0z" />
  </>}
  {name === 'hourglass' && <>
    <path d="M6.5 3.5h11M6.5 20.5h11M7.5 3.5c0 4 4.5 5.5 4.5 8.5S7.5 16.5 7.5 20.5M16.5 3.5c0 4-4.5 5.5-4.5 8.5s4.5 4.5 4.5 8.5" />
  </>}
  {name === 'info' && <>
    <circle cx="12" cy="12" r="9" /><path d="M12 11v5.5M12 7.5h.01" />
  </>}
  {name === 'dot' && <circle cx="12" cy="12" r="4" />}
</svg>
