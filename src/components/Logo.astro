---
// Croissant de lune : un disque dont on retire un second disque décalé.
interface Props { size?: number; id?: string }
const { size = 28, id = 'logo' } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class="logo-mark">
  <mask id={`${id}-m`}>
    <rect width="32" height="32" fill="#fff" />
    <circle cx="21" cy="12" r="10.5" fill="#000" />
  </mask>
  <circle cx="16" cy="16" r="13" fill="currentColor" mask={`url(#${id}-m)`} />
</svg>
