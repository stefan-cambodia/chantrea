---
// Corps de la fiche ASokoban (jeu de pousse-caisses pour Android), dans src/pages/[lang]/[app].astro.
// Bandeau avec trois téléphones, la règle avec un petit plateau animé, le même niveau en 2D et en 3D,
// galerie, autres points avec pictogrammes, la version khmère, ce que le projet montre.
// Textes : apps.asokoban.* de chaque fichier de langue ; aucun texte propre à ce composant
// (badges : « Android », « 2D · 3D », noms des langues dans leur propre écriture).
import ScreenGallery from '../ScreenGallery.astro';
import HmsIcon from '../HmsIcon.astro';
import { Picture } from 'astro:assets';
import { href } from '../../i18n/index.js';

interface Props { app: any; a: any; tr: any; lang: string }
const { app, a, tr, lang } = Astro.props;
const shot = (c) => app.screens.find((s) => s.caption === c);
// groups : 0 règle, 1 niveaux sans erreur, 2 droit à l'erreur, 3 2D ou 3D, 4 façons de jouer, 5 langues.
const [rule, levels, undo, dims, controls, langs] = a.groups;
const cards = [levels, undo, controls];
const cardIcons = ['check', 'undo', 'mobile'];
const heroPhones = ['levels', 'home', 'board3dDark'].map(shot);
const pair = [{ s: shot('board2d'), tag: '2D' }, { s: shot('board3d'), tag: '3D' }];
const khmer = shot('khmer');
const phoneImg = { formats: ['avif', 'webp'], widths: [270, 400, 540], quality: 80 };
// Petit plateau : 7 × 5 cases de 40, murs autour, une caisse à pousser deux fois vers la cible.
const W = 7, H = 5, C = 40;
const walls = [];
for (let x = 0; x < W; x++) for (let y = 0; y < H; y++) if (x === 0 || y === 0 || x === W - 1 || y === H - 1) walls.push([x, y]);
walls.push([3, 1], [3, 3]);
---
<section class="page-hero night soko-hero">
  <div class="container hms-hero__grid">
    <div>
      <p class="eyebrow">{a.eyebrow}</p>
      <h1>{a.title}</h1>
      <p class="lead">{a.lead}</p>
      <p class="status"><span class="sr-only">{tr.work.status} : </span>{a.status}</p>
      <p class="hero-badges">
        <span>Android</span><span>2D · 3D</span><span lang="en">English</span><span lang="km">ខ្មែរ</span>
      </p>
    </div>
    <div class="soko-trio" aria-hidden="true">
      {heroPhones.map((p, i) => (
        <div class={`mini-phone soko-trio__p soko-trio__p--${i + 1}`}>
          <Picture src={p.src} alt="" {...phoneImg} sizes="(min-width: 900px) 200px, 32vw" loading="eager" />
        </div>
      ))}
    </div>
  </div>
  <div class="hero__moon hero__moon--small" aria-hidden="true"></div>
</section>

<section class="section" aria-labelledby="rule-title">
  <div class="container split split--center">
    <svg class="soko-board" viewBox={`0 0 ${W * C} ${H * C}`} aria-hidden="true" focusable="false">
      <rect width={W * C} height={H * C} class="soko-board__floor" />
      {walls.map(([x, y]) => <rect x={x * C + 1} y={y * C + 1} width={C - 2} height={C - 2} rx="4" class="soko-board__wall" />)}
      <circle cx={4 * C + C / 2} cy={2 * C + C / 2} r="10" class="soko-board__target" />
      <g class="soko-board__box"><rect x={2 * C + 5} y={2 * C + 5} width={C - 10} height={C - 10} rx="5" /><path d={`M${2 * C + 11} ${2 * C + 11}l18 18M${2 * C + 29} ${2 * C + 11}l-18 18`} /></g>
      <g class="soko-board__player"><circle cx={1 * C + C / 2} cy={2 * C + C / 2} r="12" /><circle cx={1 * C + C / 2 + 4} cy={2 * C + C / 2 - 3} r="2.2" class="soko-board__eye" /></g>
    </svg>
    <div>
      <h2 id="rule-title">{rule.title}</h2>
      <ul class="checklist">{rule.items.map((i) => <li>{i}</li>)}</ul>
    </div>
  </div>
</section>

<section class="section night" aria-labelledby="dims-title">
  <div class="container split split--center">
    <div>
      <h2 id="dims-title">{dims.title}</h2>
      <ul class="checklist">{dims.items.map((i) => <li>{i}</li>)}</ul>
    </div>
    <div class="soko-pair">
      {pair.map((p) => (
        <figure>
          <div class="mini-phone">
            <Picture src={p.s.src} alt={a.gallery.captions[p.s.caption]} {...phoneImg} sizes="(min-width: 900px) 220px, 42vw" loading="lazy" />
          </div>
          <figcaption aria-hidden="true">{p.tag}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<ScreenGallery screens={app.screens} texts={a.gallery} />

<section class="section section--alt" aria-labelledby="features-title">
  <div class="container">
    <h2 id="features-title">{a.featuresTitle}</h2>
    <ul class="cards cards--3 rally-features">
      {cards.map((g, i) => (
        <li class="card">
          <span class="rally-features__icon"><HmsIcon name={cardIcons[i]} size={26} /></span>
          <h3>{g.title}</h3>
          <ul class="checklist checklist--sm">{g.items.map((i) => <li>{i}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="langs-title">
  <div class="container split split--center soko-langs">
    <div class="mini-phone soko-langs__phone">
      <Picture src={khmer.src} alt={a.gallery.captions.khmer} {...phoneImg} sizes="(min-width: 900px) 240px, 60vw" loading="lazy" />
    </div>
    <div>
      <p class="soko-langs__icon"><HmsIcon name="lang" size={28} /></p>
      <h2 id="langs-title">{langs.title}</h2>
      <ul class="checklist">{langs.items.map((i) => <li>{i}</li>)}</ul>
    </div>
  </div>
</section>

<section class="section section--alt" aria-labelledby="shows-title">
  <div class="container split split--center">
    <div>
      <h2 id="shows-title">{a.shows.title}</h2>
      <p class="lead-sm">{a.shows.text}</p>
      <a class="btn btn--ghost" href={href(lang, 'work')}>{a.shows.cta}</a>
    </div>
    <ul class="checklist single-panel">{a.shows.items.map((i) => <li>{i}</li>)}</ul>
  </div>
</section>
