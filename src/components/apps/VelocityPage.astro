---
// Corps de la fiche Velocity, dans src/pages/[lang]/[app].astro.
// Bandeau photo (Noctis Rift au coucher du soleil) et badges, les circuits vus du ciel, galerie,
// le pilotage avec l'écran de course, autres points avec pictogrammes, « tout est généré par le code ».
// Textes : apps.velocity.* de chaque fichier de langue (badges compris).
import ScreenGallery from '../ScreenGallery.astro';
import HmsIcon from '../HmsIcon.astro';
import CodeBand from './CodeBand.astro';
import { Picture } from 'astro:assets';
import { href } from '../../i18n/index.js';

interface Props { app: any; a: any; tr: any; lang: string }
const { app, a, tr, lang } = Astro.props;
const shot = (c) => app.screens.find((s) => s.caption === c);
// groups : 0 circuits, 1 pilotage, 2 modes, 3 armes, 4 adversaires, 5 généré par le code.
const [circuits, handling, modes, weapons, rivals, code] = a.groups;
const cards = [modes, weapons, rivals];
const cardIcons = ['layers', 'sparkles', 'cpu'];
const img = { formats: ['avif', 'webp'], widths: [480, 720, 960, 1280], quality: 78, sizes: '(min-width: 1120px) 536px, (min-width: 860px) 48vw, 100vw' };
const km = (b) => (/[ក-៿]/.test(b) ? 'km' : undefined);
---
<section class="page-hero night photo-hero">
  <Picture class="photo-hero__bg" src={shot('noctis').src} alt="" formats={['avif', 'webp']} widths={[640, 960, 1280]}
           sizes="100vw" quality={72} loading="eager" aria-hidden="true" />
  <div class="container">
    <p class="eyebrow">{a.eyebrow}</p>
    <h1>{a.title}</h1>
    <p class="lead">{a.lead}</p>
    <p class="status"><span class="sr-only">{tr.work.status} : </span>{a.status}</p>
    <p class="hero-badges">{a.badges.map((b) => <span lang={km(b)}>{b}</span>)}</p>
  </div>
</section>

<section class="section" aria-labelledby="circuits-title">
  <div class="container split split--center">
    <Picture class="game-shot" src={shot('helix').src} alt={a.gallery.captions.helix} {...img} loading="lazy" />
    <div>
      <h2 id="circuits-title">{circuits.title}</h2>
      <ul class="checklist">{circuits.items.map((i) => <li>{i}</li>)}</ul>
    </div>
  </div>
</section>

<ScreenGallery screens={app.screens} texts={a.gallery} alt />

<section class="section" aria-labelledby="handling-title">
  <div class="container split split--center">
    <div>
      <h2 id="handling-title">{handling.title}</h2>
      <ul class="checklist">{handling.items.map((i) => <li>{i}</li>)}</ul>
    </div>
    <Picture class="game-shot" src={shot('hud').src} alt={a.gallery.captions.hud} {...img} loading="lazy" />
  </div>
</section>

<section class="section section--alt" aria-labelledby="features-title">
  <div class="container">
    <h2 id="features-title">{a.featuresTitle}</h2>
    <ul class="cards cards--3 rally-features">
      {cards.map((g, i) => (
        <li class="card">
          <span class="rally-features__icon"><HmsIcon name={cardIcons[i]} size={26} /></span>
          <h3>{g.title}</h3>
          <ul class="checklist checklist--sm">{g.items.map((i) => <li>{i}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<CodeBand group={code} />

<section class="section" aria-labelledby="shows-title">
  <div class="container split split--center">
    <div>
      <h2 id="shows-title">{a.shows.title}</h2>
      <p class="lead-sm">{a.shows.text}</p>
      <a class="btn btn--ghost" href={href(lang, 'work')}>{a.shows.cta}</a>
    </div>
    <ul class="checklist single-panel">{a.shows.items.map((i) => <li>{i}</li>)}</ul>
  </div>
</section>
