---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, href } from '../i18n/index.js';
interface Props { lang: string; page?: string }
const { lang, page = '' } = Astro.props;
const tr = t(lang);
const links = [
  ['services', tr.nav.services],
  ['hms', tr.nav.hms],
  ['work', tr.nav.work],
  ['about', tr.nav.about],
  ['contact', tr.nav.contact],
];
---
<a class="skip-link" href="#main">{tr.a11y.skip}</a>
<header class="site-header night">
  <div class="container site-header__bar">
    <a class="brand" href={href(lang)} aria-label={tr.a11y.home}>
      <Logo id="logo-h" />
      <span class="brand__name">Chantrea <span>Systems</span></span>
    </a>

    <nav class="main-nav" aria-label={tr.a11y.mainNav}>
      <ul>
        {links.map(([slug, label]) => (
          <li><a href={href(lang, slug)} aria-current={page === slug ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <LangSwitcher lang={lang} page={page} label={tr.a11y.language} />
      <ThemeToggle lang={lang} />
      <details class="mobile-nav">
        <summary>{tr.a11y.menu}</summary>
        <nav aria-label={tr.a11y.mainNav}>
          <ul>
            {links.map(([slug, label]) => (
              <li><a href={href(lang, slug)} aria-current={page === slug ? 'page' : undefined}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
