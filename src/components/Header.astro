---
import Brand from './Brand.astro';
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, href } from '../i18n/index.js';
import config from '../../site.config.mjs';
interface Props { lang: string; page?: string }
const { lang, page = '' } = Astro.props;
const tr = t(lang);
// Cambodia Rally, Angkor 3D et les fiches Android sont rangés sous « Réalisations » ;
// la page « Odoo en khmer » est rangée sous le lien « Odoo » (développement de modules Odoo).
const sectionOf: Record<string, string> = {
  rally: 'work', angkor: 'work', acpc: 'work', asokoban: 'work', '3d-snake': 'work', velocity: 'work',
  'services/odoo-cambodia': 'services/odoo-development',
};
// key : texte dans nav ; slug : adresse de la page.
const links = [
  { key: 'services', slug: 'services' },
  { key: 'hms', slug: 'hms' },
  { key: 'odoo', slug: 'services/odoo-development' },
  { key: 'work', slug: 'work' },
  { key: 'whatsNew', slug: 'whats-new' },
  { key: 'about', slug: 'about' },
  { key: 'jobs', slug: 'jobs' },
  { key: 'contact', slug: 'contact' },
].map(({ key, slug }) => ({
  slug,
  label: tr.nav[key],
  current: page === slug ? 'page' : page.startsWith(`${slug}/`) || sectionOf[page] === slug ? 'true' : undefined,
}));
// Lien « Espace client » : affiché seulement quand portalUrl est renseigné dans site.config.mjs.
const portal = config.portalUrl;
---
<a class="skip-link" href="#main">{tr.a11y.skip}</a>
<header class={portal ? 'site-header night has-portal' : 'site-header night'}>
  <div class="container site-header__bar">
    <Brand home={href(lang)} label={tr.a11y.home} id="logo-h" />

    <nav class="main-nav" aria-label={tr.a11y.mainNav}>
      <ul>
        {links.map((l) => <li><a href={href(lang, l.slug)} aria-current={l.current}>{l.label}</a></li>)}
        {portal && <li class="nav-portal"><a href={portal}>{tr.nav.portal}</a></li>}
      </ul>
    </nav>

    <div class="site-header__tools">
      <LangSwitcher lang={lang} page={page} label={tr.a11y.language} />
      <ThemeToggle lang={lang} />
      <details class="mobile-nav">
        <summary>
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="sr-only">{tr.a11y.menu}</span>
        </summary>
        <nav aria-label={tr.a11y.mainNav}>
          <ul>
            {links.map((l) => <li><a href={href(lang, l.slug)} aria-current={l.current}>{l.label}</a></li>)}
            {portal && <li class="nav-portal"><a href={portal}>{tr.nav.portal}</a></li>}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
