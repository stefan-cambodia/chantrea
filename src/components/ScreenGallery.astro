---
// Galerie de captures : images optimisées (AVIF/WebP, plusieurs tailles),
// chargées seulement quand elles approchent de l'écran. Un clic ouvre la grande version.
// screens : [{ caption, src }], la première en grand (sauf capture en hauteur).
// Les captures en hauteur (téléphone tenu droit) s'affichent deux par ligne sur téléphone, quatre sur grand écran.
// texts   : { title, note, enlarge, captions } (ex. hms.gallery d'un fichier de langue).
// alt     : fond alterné (section--alt).
import { Picture, getImage } from 'astro:assets';

interface Props { screens: { caption: string; src: ImageMetadata }[]; texts: any; alt?: boolean }
const { screens: list, texts: g, alt = false } = Astro.props;
const screens = await Promise.all(
  list.map(async (s, i) => ({
    ...s,
    alt: g.captions[s.caption],
    full: (await getImage({ src: s.src, width: Math.min(1440, s.src.width), format: 'webp', quality: 85 })).src,
    tall: s.src.height > s.src.width,
    featured: i === 0 && s.src.height <= s.src.width,
    eager: i === 0,
  })),
);
---
<section class={alt ? 'section section--alt' : 'section'} aria-labelledby="gallery-title">
  <div class="container">
    <h2 id="gallery-title">{g.title}</h2>
    <p class="section__intro">{g.note}</p>
    <ul class="gallery">
      {screens.map((s) => (
        <li class={['gallery__item', s.featured && 'gallery__item--featured', s.tall && 'gallery__item--tall'].filter(Boolean).join(' ')}>
          <figure>
            <a href={s.full} class="gallery__link">
              <Picture
                src={s.src}
                alt={s.alt}
                formats={['avif', 'webp']}
                widths={s.featured ? [640, 960, 1440] : s.tall ? [270, 400, 540] : [480, 720, 960]}
                sizes={s.featured ? '(min-width: 1120px) 1088px, 100vw' : s.tall ? '(min-width: 1120px) 260px, (min-width: 700px) 25vw, 50vw' : '(min-width: 1120px) 536px, (min-width: 700px) 50vw, 100vw'}
                quality={80}
                loading={s.eager ? 'eager' : 'lazy'}
              />
              <span class="sr-only"> ({g.enlarge})</span>
            </a>
            <figcaption>{s.alt}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
