---
import ContactButtons from './ContactButtons.astro';
import { t } from '../i18n/index.js';
interface Props { lang: string }
const tr = t(Astro.props.lang);
---
<section class="section night cta" aria-labelledby="cta-title">
  <div class="container">
    <h2 id="cta-title">{tr.cta.title}</h2>
    <p class="lead">{tr.cta.text}</p>
    <ContactButtons lang={Astro.props.lang} />
  </div>
</section>
